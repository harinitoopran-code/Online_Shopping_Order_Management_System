<%@ page contentType="text/html;charset=UTF-8" %><%@ page import="java.sql.*,edu.student.shop.DB,edu.student.shop.Auth" %><link rel="stylesheet" href="css/style.css"><main><h2>Your Cart</h2><% Integer uid=Auth.userId(request); if(uid==null){response.sendRedirect("login.jsp");return;} try(Connection c=DB.get();PreparedStatement s=c.prepareStatement("SELECT p.product_id,p.product_name,p.price,ci.quantity FROM carts ca JOIN cart_items ci ON ca.cart_id=ci.cart_id JOIN products p ON p.product_id=ci.product_id WHERE ca.user_id=?")){s.setInt(1,uid);try(ResultSet r=s.executeQuery()){while(r.next()){ %><div class="item"><%=r.getString("product_name")%> — ₹<%=r.getBigDecimal("price")%> × <%=r.getInt("quantity")%><form method="post" action="cart"><input type="hidden" name="productId" value="<%=r.getInt("product_id")%>"><input type="hidden" name="action" value="update"><input type="number" name="quantity" min="1" value="<%=r.getInt("quantity")%>"><button>Update</button></form><form method="post" action="cart"><input type="hidden" name="productId" value="<%=r.getInt("product_id")%>"><input type="hidden" name="action" value="remove"><button>Remove</button></form></div><%}}} %><a href="checkout.jsp">Proceed to checkout</a></main>