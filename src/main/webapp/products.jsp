<%@ page contentType="text/html;charset=UTF-8" %><%@ page import="java.util.*" %><link rel="stylesheet" href="css/style.css"><main><h2>Product Catalogue</h2><form method="get" action="products"><input name="q" placeholder="Search name/category"><button>Search</button></form><p><a href="cart.jsp">Cart</a> | <a href="orders.jsp">My Orders</a> | <a href="logout">Logout</a></p><% List<Map<String,Object>> ps=(List<Map<String,Object>>)request.getAttribute("products"); if(ps!=null) for(Map<String,Object> x:ps){ %><section class="item"><h3><%=x.get("name")%></h3><p><%=x.get("description")%></p><p>Category: <%=x.get("category")%> | Price: ₹<%=x.get("price")%> | Stock: <%=x.get("stock")%></p><form method="post" action="cart"><input type="hidden" name="action" value="add"><input type="hidden" name="productId" value="<%=x.get("id")%>"><input type="number" name="quantity" value="1" min="1"><button>Add to cart</button></form></section><% } %></main>