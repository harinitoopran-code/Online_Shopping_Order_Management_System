<%@ page contentType="text/html;charset=UTF-8" %><%@ page import="java.sql.*,edu.student.shop.DB,edu.student.shop.Auth" %><link rel="stylesheet" href="css/style.css"><main><h2>Order History</h2><% Integer uid=Auth.userId(request); if(uid==null){response.sendRedirect("login.jsp");return;} try(Connection c=DB.get();PreparedStatement s=c.prepareStatement("SELECT order_id,order_date,total_amount,order_status FROM orders WHERE user_id=? ORDER BY order_date DESC")){s.setInt(1,uid);try(ResultSet r=s.executeQuery()){while(r.next()){ %><p>Order #<%=r.getInt(1)%> | <%=r.getTimestamp(2)%> | ₹<%=r.getBigDecimal(3)%> | <%=r.getString(4)%></p><%}}} %></main>